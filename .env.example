# BlueprintSight VL — Nebius Token Factory x NVIDIA NIM CAD Inspector (Port 5185)
# Works 100% locally in deterministic_local mode with zero cloud API keys required.

VITE_HOST=127.0.0.1
VITE_PORT=5185
VITE_STRICT_PORT=true
VITE_DEFAULT_MODE=deterministic_local

# Optional Nebius Token Factory & NVIDIA NIM Endpoints (4,500ms circuit breaker fallback)
VITE_NEBIUS_TOKEN_FACTORY_URL=https://api.tokenfactory.us-central1.nebius.com/v1/chat/completions
VITE_NEBIUS_API_KEY=
VITE_NEBIUS_VLM_MODEL=nvidia/NVLM-1.0-72B
VITE_NEBIUS_LLM_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct
